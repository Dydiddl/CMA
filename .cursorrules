#### 테스트 작성 규칙
```python
# tests/test_ascr_processor.py
import pytest
from unittest.mock import Mock, patch
from app.services.ascr.main import ASCRProcessor

class TestASCRProcessor:
    @pytest.fixture
    def processor(self):
        return ASCRProcessor()
    
    def test_extract_toc_success(self, processor):
        """목차 추출 성공 테스트"""
        # Given
        mock_pdf_file = Mock()
        year = 2025
        
        # When
        result = processor.extract_toc(mock_pdf_file, year)
        
        # Then
        assert result["year"] == year
        assert "output_file" in result
    
    def test_extract_toc_failure(self, processor):
        """목차 추출 실패 테스트"""
        # Given
        mock_pdf_file = Mock()
        mock_pdf_file.side_effect = Exception("PDF 처리 오류")
        
        # When & Then
        with pytest.raises(Exception):
            processor.extract_toc(mock_pdf_file, 2025)
```

