### 10. 배포 규칙

#### 환경별 설정
```python
# core/environments.py
from enum import Enum
from typing import Dict, Any

class Environment(Enum):
    DEVELOPMENT = "development"
    STAGING = "staging"
    PRODUCTION = "production"

class EnvironmentConfig:
    """환경별 설정 관리"""
    
    @staticmethod
    def get_config(env: Environment) -> Dict[str, Any]:
        configs = {
            Environment.DEVELOPMENT: {
                "debug": True,
                "database_url": "postgresql://dev:dev@localhost/cma_dev",
                "log_level": "DEBUG",
                "cors_origins": ["http://localhost:3000"],
            },
            Environment.STAGING: {
                "debug": False,
                "database_url": "postgresql://staging:staging@staging-db/cma_staging",
                "log_level": "INFO",
                "cors_origins": ["https://staging.cma.com"],
            },
            Environment.PRODUCTION: {
                "debug": False,
                "database_url": "postgresql://prod:prod@prod-db/cma_prod",
                "log_level": "WARNING",
                "cors_origins": ["https://cma.com"],
            }
        }
        return configs[env]
```

#### 배포 스크립트
```bash
#!/bin/bash
# scripts/deploy.sh

set -e

ENVIRONMENT=$1
VERSION=$2

if [ -z "$ENVIRONMENT" ] || [ -z "$VERSION" ]; then
    echo "Usage: ./deploy.sh <environment> <version>"
    echo "Example: ./deploy.sh staging v1.2.0"
    exit 1
fi

echo "🚀 배포 시작: $ENVIRONMENT 환경, 버전 $VERSION"

# 1. 환경 검증
echo "📋 환경 검증 중..."
if [ "$ENVIRONMENT" != "staging" ] && [ "$ENVIRONMENT" != "production" ]; then
    echo "❌ 잘못된 환경: $ENVIRONMENT"
    exit 1
fi

# 2. 데이터베이스 마이그레이션
echo "🗄️ 데이터베이스 마이그레이션 중..."
cd backend
alembic upgrade head

# 3. 백엔드 배포
echo "🔧 백엔드 배포 중..."
pip install -r requirements.txt
python -m pytest tests/ -v

# 4. 프론트엔드 빌드
echo "🎨 프론트엔드 빌드 중..."
cd ../frontend
npm ci
npm run build

# 5. Tauri 앱 빌드
echo "📱 Tauri 앱 빌드 중..."
npm run tauri build

# 6. 배포 완료
echo "✅ 배포 완료: $ENVIRONMENT 환경, 버전 $VERSION"
```

### 11. 모니터링 및 로깅

#### 로깅 설정
```python
# core/logging.py
import logging
import logging.handlers
from pathlib import Path
from datetime import datetime

def setup_logging(log_level: str = "INFO", log_file: str = "./logs/cma.log"):
    """로깅 설정"""
    
    # 로그 디렉토리 생성
    log_path = Path(log_file)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    
    # 로그 포맷 설정
    formatter = logging.Formatter(
        '%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )
    
    # 파일 핸들러 (일별 로테이션)
    file_handler = logging.handlers.TimedRotatingFileHandler(
        log_file,
        when='midnight',
        interval=1,
        backupCount=30,
        encoding='utf-8'
    )
    file_handler.setFormatter(formatter)
    
    # 콘솔 핸들러
    console_handler = logging.StreamHandler()
    console_handler.setFormatter(formatter)
    
    # 루트 로거 설정
    root_logger = logging.getLogger()
    root_logger.setLevel(getattr(logging, log_level.upper()))
    root_logger.addHandler(file_handler)
    root_logger.addHandler(console_handler)
    
    # 특정 모듈 로그 레벨 설정
    logging.getLogger('sqlalchemy.engine').setLevel(logging.WARNING)
    logging.getLogger('uvicorn.access').setLevel(logging.INFO)
```

#### 성능 모니터링
```python
# middleware/performance.py
import time
import logging
from fastapi import Request, Response
from starlette.middleware.base import BaseHTTPMiddleware

logger = logging.getLogger(__name__)

class PerformanceMiddleware(BaseHTTPMiddleware):
    """성능 모니터링 미들웨어"""
    
    async def dispatch(self, request: Request, call_next):
        start_time = time.time()
        
        # 요청 처리
        response = await call_next(request)
        
        # 처리 시간 계산
        process_time = time.time() - start_time
        
        # 로그 기록
        logger.info(
            f"요청 처리 완료: {request.method} {request.url.path} - "
            f"상태코드: {response.status_code}, "
            f"처리시간: {process_time:.3f}초"
        )
        
        # 응답 헤더에 처리 시간 추가
        response.headers["X-Process-Time"] = str(process_time)
        
        return response
```

이러한 규칙들을 따라 CMA 프로젝트의 코드 품질과 일관성을 유지하세요.
