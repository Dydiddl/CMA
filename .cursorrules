## 🚨 CRITICAL RULES - MUST FOLLOW

### 1. 코드 스타일 (PEP8 준수, snake_case 변수명)

#### Python 백엔드
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
건설 관리 시스템 - [모듈명]
[모듈 설명]
"""

from typing import List, Dict, Optional, Union
from datetime import datetime
from pathlib import Path
import logging

logger = logging.getLogger(__name__)

class ConstructionContract:
    """건설 계약 관리 클래스"""
    
    def __init__(self, contract_id: str, project_name: str):
        self.contract_id = contract_id
        self.project_name = project_name
        self.created_at = datetime.now()
        self.status = "draft"
    
    def calculate_total_cost(self, labor_cost: float, material_cost: float) -> float:
        """총 비용 계산"""
        return labor_cost + material_cost
    
    def update_contract_status(self, new_status: str) -> bool:
        """계약 상태 업데이트"""
        try:
            self.status = new_status
            logger.info(f"계약 상태 업데이트: {self.contract_id} -> {new_status}")
            return True
        except Exception as e:
            logger.error(f"계약 상태 업데이트 실패: {e}")
            return False
```

#### TypeScript 프론트엔드
```typescript
// 파일명: construction-contract.ts
// 컴포넌트명: ConstructionContract
// 변수명: camelCase
// 상수명: UPPER_SNAKE_CASE

interface ConstructionContract {
  contractId: string;
  projectName: string;
  totalCost: number;
  status: ContractStatus;
  createdAt: Date;
}

enum ContractStatus {
  DRAFT = 'draft',
  ACTIVE = 'active',
  COMPLETED = 'completed',
  CANCELLED = 'cancelled'
}

const CONTRACT_STATUS_LABELS: Record<ContractStatus, string> = {
  [ContractStatus.DRAFT]: '초안',
  [ContractStatus.ACTIVE]: '진행중',
  [ContractStatus.COMPLETED]: '완료',
  [ContractStatus.CANCELLED]: '취소'
};

export const ConstructionContractComponent: React.FC<{
  contract: ConstructionContract;
  onStatusChange: (status: ContractStatus) => void;
}> = ({ contract, onStatusChange }) => {
  const handleStatusUpdate = (newStatus: ContractStatus) => {
    try {
      onStatusChange(newStatus);
    } catch (error) {
      console.error('계약 상태 업데이트 실패:', error);
    }
  };

  return (
    <div className="construction-contract">
      <h3>{contract.projectName}</h3>
      <p>계약 ID: {contract.contractId}</p>
      <p>총 비용: {contract.totalCost.toLocaleString()}원</p>
      <p>상태: {CONTRACT_STATUS_LABELS[contract.status]}</p>
    </div>
  );
};
```

### 🆕 2. ASCR 모듈 개발 규칙

#### ASCR API 엔드포인트 설계
```python
# api/v1/endpoints/ascr.py
from fastapi import APIRouter, UploadFile, File, Form, HTTPException
from typing import Optional, List
import logging

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/ascr", tags=["ASCR"])

@router.post("/extract-toc")
async def extract_toc(
    file: UploadFile = File(...),
    year: int = Form(2025)
):
    """
    PDF 목차 추출 API
    
    Args:
        file: PDF 파일
        year: 연도 (기본값: 2025)
    
    Returns:
        Dict: 목차 구조 정보
    """
    try:
        # ASCR 프로세서 호출
        processor = ASCRProcessor()
        result = processor.extract_toc(file.file, year)
        logger.info(f"목차 추출 완료: {file.filename}")
        return {"status": "success", "data": result}
    except Exception as e:
        logger.error(f"목차 추출 실패: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/extract-text")
async def extract_text(
    file: UploadFile = File(...),
    pages: Optional[List[int]] = Form(None)
):
    """PDF 텍스트 추출 API"""
    try:
        processor = ASCRProcessor()
        result = processor.extract_text(file.file, pages)
        return {"status": "success", "data": result}
    except Exception as e:
        logger.error(f"텍스트 추출 실패: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/split-pdf")
async def split_pdf(
    file: UploadFile = File(...),
    toc_structure: str = Form(...)
):
    """PDF 분할 API"""
    try:
        processor = ASCRProcessor()
        result = processor.split_pdf(file.file, toc_structure)
        return {"status": "success", "data": result}
    except Exception as e:
        logger.error(f"PDF 분할 실패: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/download-standard-price")
async def download_standard_price(
    year: int = Form(2025),
    force_update: bool = Form(False)
):
    """표준 가격 목록 다운로드 API"""
    try:
        processor = ASCRProcessor()
        result = processor.download_standard_price(year, force_update)
        return {"status": "success", "data": result}
    except Exception as e:
        logger.error(f"표준 가격 목록 다운로드 실패: {e}")
        raise HTTPException(status_code=500, detail=str(e))
```

#### ASCR 서비스 클래스 설계
```python
# services/ascr/main.py
from typing import Dict, List, Optional, Any
import logging
from pathlib import Path
import json

logger = logging.getLogger(__name__)

class ASCRProcessor:
    """ASCR 모듈 메인 프로세서"""
    
    def __init__(self, config_path: Optional[str] = None):
        self.config = self._load_config(config_path)
        self.logger = logging.getLogger(__name__)
        self.input_dir = Path(self.config.get("input_dir", "./input"))
        self.output_dir = Path(self.config.get("output_dir", "./output"))
    
    def _load_config(self, config_path: Optional[str]) -> Dict[str, Any]:
        """설정 파일 로드"""
        # 설정 로드 로직
        return {}
    
    def extract_toc(self, pdf_file, year: int = 2025) -> Dict[str, Any]:
        """
        PDF 목차 추출
        
        Args:
            pdf_file: PDF 파일 객체
            year: 연도
            
        Returns:
            Dict: 목차 구조 정보
        """
        try:
            # 목차 추출 로직 구현
            self.logger.info(f"목차 추출 시작: 연도 {year}")
            
            # 결과 저장
            output_file = self.output_dir / f"toc_structure_{year}.json"
            with open(output_file, 'w', encoding='utf-8') as f:
                json.dump({"year": year, "structure": {}}, f, ensure_ascii=False, indent=2)
            
            self.logger.info(f"목차 추출 완료: {output_file}")
            return {"output_file": str(output_file), "year": year}
            
        except Exception as e:
            self.logger.error(f"목차 추출 실패: {e}")
            raise
    
    def extract_text(self, pdf_file, pages: Optional[List[int]] = None) -> Dict[str, Any]:
        """PDF 텍스트 추출"""
        try:
            self.logger.info("텍스트 추출 시작")
            # 텍스트 추출 로직 구현
            return {"status": "success", "text": ""}
        except Exception as e:
            self.logger.error(f"텍스트 추출 실패: {e}")
            raise
    
    def split_pdf(self, pdf_file, toc_structure: str) -> List[str]:
        """PDF 분할"""
        try:
            self.logger.info("PDF 분할 시작")
            # PDF 분할 로직 구현
            return []
        except Exception as e:
            self.logger.error(f"PDF 분할 실패: {e}")
            raise
    
    def download_standard_price(self, year: int, force_update: bool = False) -> Dict[str, Any]:
        """표준 가격 목록 다운로드"""
        try:
            self.logger.info(f"표준 가격 목록 다운로드 시작: 연도 {year}")
            # 다운로드 로직 구현
            return {"status": "success", "year": year}
        except Exception as e:
            self.logger.error(f"표준 가격 목록 다운로드 실패: {e}")
            raise
```

