## 🚨 CRITICAL RULES - MUST FOLLOW

### 1. 코드 스타일 (PEP8 준수, snake_case 변수명)

#### Python 백엔드
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
건설 관리 시스템 - [모듈명]
[모듈 설명]
"""

from typing import List, Dict, Optional, Union
from datetime import datetime
from pathlib import Path
import logging

logger = logging.getLogger(__name__)

class ConstructionContract:
    """건설 계약 관리 클래스"""
    
    def __init__(self, contract_id: str, project_name: str):
        self.contract_id = contract_id
        self.project_name = project_name
        self.created_at = datetime.now()
        self.status = "draft"
    
    def calculate_total_cost(self, labor_cost: float, material_cost: float) -> float:
        """총 비용 계산"""
        return labor_cost + material_cost
    
    def update_contract_status(self, new_status: str) -> bool:
        """계약 상태 업데이트"""
        try:
            self.status = new_status
            logger.info(f"계약 상태 업데이트: {self.contract_id} -> {new_status}")
            return True
        except Exception as e:
            logger.error(f"계약 상태 업데이트 실패: {e}")
            return False
```

#### TypeScript 프론트엔드
```typescript
// 파일명: construction-contract.ts
// 컴포넌트명: ConstructionContract
// 변수명: camelCase
// 상수명: UPPER_SNAKE_CASE

interface ConstructionContract {
  contractId: string;
  projectName: string;
  totalCost: number;
  status: ContractStatus;
  createdAt: Date;
}

enum ContractStatus {
  DRAFT = 'draft',
  ACTIVE = 'active',
  COMPLETED = 'completed',
  CANCELLED = 'cancelled'
}

const CONTRACT_STATUS_LABELS: Record<ContractStatus, string> = {
  [ContractStatus.DRAFT]: '초안',
  [ContractStatus.ACTIVE]: '진행중',
  [ContractStatus.COMPLETED]: '완료',
  [ContractStatus.CANCELLED]: '취소'
};

export const ConstructionContractComponent: React.FC<{
  contract: ConstructionContract;
  onStatusChange: (status: ContractStatus) => void;
}> = ({ contract, onStatusChange }) => {
  const handleStatusUpdate = (newStatus: ContractStatus) => {
    try {
      onStatusChange(newStatus);
    } catch (error) {
      console.error('계약 상태 업데이트 실패:', error);
    }
  };

  return (
    <div className="construction-contract">
      <h3>{contract.projectName}</h3>
      <p>계약 ID: {contract.contractId}</p>
      <p>총 비용: {contract.totalCost.toLocaleString()}원</p>
      <p>상태: {CONTRACT_STATUS_LABELS[contract.status]}</p>
    </div>
  );
};
```

### 🆕 2. 이모지 사용 최소화 규칙 (MANDATORY)

#### 이모지 사용 제한 사유
- **크로스 플랫폼 호환성**: macOS, Windows, Linux 간 이모지 렌더링 차이
- **폰트 지원 문제**: 시스템 폰트에서 지원하지 않는 이모지로 인한 깨짐 현상
- **가독성 향상**: 텍스트 기반 표현이 더 명확하고 일관성 있음
- **접근성**: 스크린 리더 및 보조 기술과의 호환성

#### 이모지 사용 금지 영역
```python
# 금지: 이모지 사용
logger.info("✅ 성공적으로 처리되었습니다")
print("❌ 오류가 발생했습니다")
return {"status": "⚠️ 경고", "message": "데이터가 누락되었습니다"}

# 권장: 텍스트 기반 표현
logger.info("[SUCCESS] 성공적으로 처리되었습니다")
print("[ERROR] 오류가 발생했습니다")
return {"status": "WARNING", "message": "데이터가 누락되었습니다"}
```

#### 허용되는 이모지 (최소한으로)
```python
# 허용: 기본적인 상태 표시 (안정적인 이모지만)
# ✅ 성공 (대신) [SUCCESS] 또는 [OK]
# ❌ 실패 (대신) [ERROR] 또는 [FAIL]
# ⚠️ 경고 (대신) [WARNING] 또는 [CAUTION]
# ℹ️ 정보 (대신) [INFO] 또는 [NOTE]

# 권장: 텍스트 기반 상태 표시
STATUS_SUCCESS = "[SUCCESS]"
STATUS_ERROR = "[ERROR]"
STATUS_WARNING = "[WARNING]"
STATUS_INFO = "[INFO]"
```

#### 코드에서 이모지 대체 규칙
```python
# Python 코드 예시
class ContractService:
    def create_contract(self, contract_data: ContractCreate) -> Contract:
        """계약 생성"""
        try:
            # 계약 생성 로직
            contract = Contract(**contract_data.dict())
            self.db.add(contract)
            self.db.commit()
            
            # 로그 메시지 (이모지 대신 텍스트 사용)
            logger.info("[SUCCESS] 계약이 성공적으로 생성되었습니다")
            return contract
            
        except Exception as e:
            # 오류 메시지 (이모지 대신 텍스트 사용)
            logger.error(f"[ERROR] 계약 생성 실패: {e}")
            raise ContractCreationError(f"계약 생성 중 오류 발생: {e}")

# TypeScript 코드 예시
const CONTRACT_STATUS = {
  SUCCESS: '[SUCCESS]',
  ERROR: '[ERROR]',
  WARNING: '[WARNING]',
  INFO: '[INFO]'
} as const;

const handleContractCreation = async (data: ContractData) => {
  try {
    const result = await contractService.create(data);
    console.log(`${CONTRACT_STATUS.SUCCESS} 계약이 성공적으로 생성되었습니다`);
    return result;
  } catch (error) {
    console.error(`${CONTRACT_STATUS.ERROR} 계약 생성 실패:`, error);
    throw error;
  }
};
```

#### 문서 및 주석에서 이모지 사용 규칙
