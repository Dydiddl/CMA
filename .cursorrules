### 🆕 3. 샤딩 기능 개발 규칙

#### 샤딩 설정 및 관리
```python
# core/sharding.py
from typing import Dict, Any, Optional
import hashlib
import logging
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

logger = logging.getLogger(__name__)

class ShardingManager:
    """샤딩 관리자"""
    
    def __init__(self, shard_count: int = 4, base_config: Dict[str, Any] = None):
        self.shard_count = shard_count
        self.base_config = base_config or {}
        self.connections = {}
        self.logger = logging.getLogger(__name__)
    
    def get_shard_key(self, data_id: str) -> int:
        """
        샤드 키 생성
        
        Args:
            data_id: 데이터 ID
            
        Returns:
            int: 샤드 키 (0 ~ shard_count-1)
        """
        hash_value = hashlib.md5(data_id.encode()).hexdigest()
        return int(hash_value, 16) % self.shard_count
    
    def get_database_url(self, shard_key: int) -> str:
        """
        샤드별 데이터베이스 URL 반환
        
        Args:
            shard_key: 샤드 키
            
        Returns:
            str: 데이터베이스 URL
        """
        return f"postgresql://user:pass@shard-{shard_key}/cma_shard_{shard_key}"
    
    def get_connection(self, shard_key: int):
        """샤드별 데이터베이스 연결 반환"""
        if shard_key not in self.connections:
            url = self.get_database_url(shard_key)
            engine = create_engine(url)
            self.connections[shard_key] = sessionmaker(bind=engine)
            self.logger.info(f"샤드 {shard_key} 연결 생성")
        
        return self.connections[shard_key]()
    
    def route_to_shard(self, data_id: str):
        """데이터 ID를 기반으로 적절한 샤드로 라우팅"""
        shard_key = self.get_shard_key(data_id)
        return self.get_connection(shard_key)
```

#### 샤딩을 활용한 서비스 구현
```python
# services/contract.py (샤딩 적용 예시)
from ..core.sharding import ShardingManager

class ContractService:
    def __init__(self, sharding_manager: ShardingManager):
        self.sharding_manager = sharding_manager
        self.logger = logging.getLogger(__name__)
    
    def create_contract(self, contract_data: ContractCreate) -> Contract:
        """계약 생성 (샤딩 적용)"""
        try:
            # 샤드 결정
            db = self.sharding_manager.route_to_shard(contract_data.contract_id)
            
            # 계약 생성
            db_contract = Contract(**contract_data.dict())
            db.add(db_contract)
            db.commit()
            db.refresh(db_contract)
            
            self.logger.info(f"계약 생성 완료: {db_contract.id}")
            return db_contract
            
        except Exception as e:
            self.logger.error(f"계약 생성 실패: {e}")
            raise
```

## 📋 추가 규칙

### 6. 데이터베이스 모델 설계
```python
# models/base.py
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy import Column, DateTime, String
from sqlalchemy.sql import func

Base = declarative_base()

class TimestampMixin:
    """타임스탬프 믹스인"""
    created_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
    updated_at = Column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False)

class SoftDeleteMixin:
    """소프트 삭제 믹스인"""
    deleted_at = Column(DateTime(timezone=True), nullable=True)
    is_deleted = Column(Boolean, default=False, nullable=False)
```

