#### 테스트 코드에서 이모지 사용 규칙
```python
# 금지: 테스트 메시지에 이모지 사용
def test_contract_creation():
    """✅ 계약 생성 테스트"""
    assert result.status == "✅ 성공"

# 권장: 명확한 텍스트 사용
def test_contract_creation():
    """계약 생성 테스트"""
    assert result.status == "success"
    assert result.message == "계약이 성공적으로 생성되었습니다"
```

#### 예외 처리에서 이모지 사용 규칙
```python
# 금지: 예외 메시지에 이모지 사용
class ContractError(Exception):
    def __init__(self, message: str):
        super().__init__(f"❌ 계약 오류: {message}")

# 권장: 명확한 텍스트 사용
class ContractError(Exception):
    def __init__(self, message: str):
        super().__init__(f"[CONTRACT_ERROR] {message}")
```

