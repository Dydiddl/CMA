## 🚨 CRITICAL RULES - MUST FOLLOW

### 1. 하이브리드 아키텍처 전략 (MANDATORY)

#### Python 기반 개발 원칙
```python
# ✅ 권장: Python으로 빠른 개발
class ContractService:
    """계약 관리 서비스 - Python으로 구현"""
    
    def __init__(self, db: Session, cache: Redis):
        self.db = db
        self.cache = cache
    
    async def create_contract(self, contract_data: ContractCreate) -> Contract:
        """계약 생성 - 비동기 처리"""
        try:
            # 캐시 확인
            cache_key = f"contract:{contract_data.contract_number}"
            cached = await self.cache.get(cache_key)
            if cached:
                return Contract.parse_raw(cached)
            
            # 데이터베이스 처리
            contract = Contract(**contract_data.dict())
            self.db.add(contract)
            await self.db.commit()
            
            # 캐시 저장
            await self.cache.setex(cache_key, 3600, contract.json())
            return contract
            
        except Exception as e:
            logger.error(f"계약 생성 실패: {e}")
            raise
```

#### 성능 최적화 패턴 (MANDATORY)
```python
# ✅ 권장: 성능 최적화 패턴
from concurrent.futures import ThreadPoolExecutor
import asyncio
from functools import lru_cache

class PerformanceOptimizedService:
    """성능 최적화된 서비스"""
    
    def __init__(self):
        self.thread_pool = ThreadPoolExecutor(max_workers=4)
        self.cache = {}
    
    @lru_cache(maxsize=1000)
    def expensive_calculation(self, data: str) -> float:
        """캐시된 계산"""
        # CPU 집약적 계산
        return sum(ord(c) for c in data)
    
    async def process_large_data(self, data_chunks: List[str]) -> List[float]:
        """대용량 데이터 병렬 처리"""
        loop = asyncio.get_event_loop()
        
        # 스레드 풀에서 CPU 집약적 작업 실행
        tasks = [
            loop.run_in_executor(self.thread_pool, self.expensive_calculation, chunk)
            for chunk in data_chunks
        ]
        
        return await asyncio.gather(*tasks)
    
    async def batch_database_operations(self, operations: List[Dict]) -> List[Result]:
        """배치 데이터베이스 작업"""
        # 배치 크기로 나누어 처리
        batch_size = 100
        results = []
        
        for i in range(0, len(operations), batch_size):
            batch = operations[i:i + batch_size]
            batch_results = await self._process_batch(batch)
            results.extend(batch_results)
        
        return results
```

#### 선택적 네이티브 전환 전략 (MANDATORY)
```python
# ✅ 권장: 핵심 성능 모듈 네이티브 전환
import ctypes
from pathlib import Path

class NativeOptimizedProcessor:
    """네이티브 최적화된 프로세서"""
    
    def __init__(self):
        # 네이티브 라이브러리 로드
        self.native_lib = ctypes.CDLL("./native_optimizations.dll")
    
    def process_pdf_native(self, pdf_path: str) -> Dict[str, Any]:
        """네이티브 PDF 처리"""
        # Python에서 네이티브 함수 호출
        result = self.native_lib.process_pdf(pdf_path.encode())
        return self._parse_native_result(result)
    
    def calculate_complex_formulas(self, data: List[float]) -> List[float]:
        """복잡한 수식 계산 - 네이티브 최적화"""
        # 대용량 수치 계산을 네이티브로 처리
        return self.native_lib.calculate_formulas(data, len(data))
```

### 2. 성능 모니터링 및 최적화 (MANDATORY)

#### 성능 지표 정의
```python
# 성능 지표 (KPI) 정의
PERFORMANCE_TARGETS = {
    "api_response_time": 500,  # ms
    "database_query_time": 100,  # ms
    "file_processing_time": 2000,  # ms (1MB 파일 기준)
    "memory_usage": 512,  # MB
    "concurrent_users": 100,
    "system_availability": 99.9  # %
}

class PerformanceMonitor:
    """성능 모니터링 클래스"""
    
    def __init__(self):
        self.metrics = {}
    
    async def monitor_api_performance(self, func):
        """API 성능 모니터링"""
        start_time = time.time()
        try:
            result = await func()
            duration = (time.time() - start_time) * 1000
            
            if duration > PERFORMANCE_TARGETS.get(func.__name__, 1000):
                logger.warning(f"느린 API 응답: {func.__name__} - {duration:.2f}ms")
            
            return result
        except Exception as e:
            logger.error(f"API 오류: {func.__name__} - {e}")
            raise
```

#### 캐싱 전략
```python
# Redis 캐싱 전략
class CacheManager:
    """캐시 관리자"""
    
    def __init__(self, redis_client: Redis):
        self.redis = redis_client
        self.default_ttl = 3600  # 1시간
    
    async def get_or_set(self, key: str, getter_func, ttl: int = None) -> Any:
        """캐시에서 가져오거나 설정"""
        # 캐시 확인
        cached = await self.redis.get(key)
        if cached:
            return json.loads(cached)
        
        # 데이터 가져오기
        data = await getter_func()
        
        # 캐시 저장
        await self.redis.setex(key, ttl or self.default_ttl, json.dumps(data))
        return data
    
    async def invalidate_pattern(self, pattern: str):
        """패턴 기반 캐시 무효화"""
        keys = await self.redis.keys(pattern)
        if keys:
            await self.redis.delete(*keys)
```

### 3. 코드 스타일 (PEP8 준수, snake_case 변수명)

#### Python 백엔드
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
건설 관리 시스템 - [모듈명]
[모듈 설명]
"""

from typing import List, Dict, Optional, Union
from datetime import datetime
from pathlib import Path
import logging

logger = logging.getLogger(__name__)

class ConstructionContract:
    """건설 계약 관리 클래스"""
    
    def __init__(self, contract_id: str, project_name: str):
        self.contract_id = contract_id
        self.project_name = project_name
        self.created_at = datetime.now()
        self.status = "draft"
    
    async def calculate_total_cost(self, labor_cost: float, material_cost: float) -> float:
        """총 비용 계산 - 비동기 처리"""
        loop = asyncio.get_event_loop()
        
        # CPU 집약적 계산을 스레드 풀에서 실행
        result = await loop.run_in_executor(
            self._thread_pool, 
            self._complex_calculation, 
            labor_cost, 
            material_cost
        )
        return result
    
    def _complex_calculation(self, labor: float, material: float) -> float:
        """복잡한 계산 로직"""
        # CPU 집약적 작업 시뮬레이션
        import math
        return math.sqrt(labor**2 + material**2) * 1.1
    
    async def update_contract_status(self, new_status: str) -> bool:
        """계약 상태 업데이트 - 비동기"""
        try:
            self.status = new_status
            logger.info(f"계약 상태 업데이트: {self.contract_id} -> {new_status}")
            return True
        except Exception as e:
            logger.error(f"계약 상태 업데이트 실패: {e}")
            return False
```

#### TypeScript 프론트엔드
```typescript
// 파일명: construction-contract.ts
// 컴포넌트명: ConstructionContract
// 변수명: camelCase
// 상수명: UPPER_SNAKE_CASE

interface ConstructionContract {
  contractId: string;
  projectName: string;
  totalCost: number;
  status: ContractStatus;
  createdAt: Date;
}

enum ContractStatus {
  DRAFT = 'draft',
  ACTIVE = 'active',
  COMPLETED = 'completed',
  CANCELLED = 'cancelled'
}

const CONTRACT_STATUS_LABELS: Record<ContractStatus, string> = {
  [ContractStatus.DRAFT]: '초안',
  [ContractStatus.ACTIVE]: '진행중',
  [ContractStatus.COMPLETED]: '완료',
  [ContractStatus.CANCELLED]: '취소'
};

export const ConstructionContractComponent: React.FC<{
  contract: ConstructionContract;
  onStatusChange: (status: ContractStatus) => void;
}> = ({ contract, onStatusChange }) => {
  const handleStatusUpdate = async (newStatus: ContractStatus) => {
    try {
      await onStatusChange(newStatus);
    } catch (error) {
      console.error('계약 상태 업데이트 실패:', error);
    }
  };

  return (
    <div className="construction-contract">
      <h3>{contract.projectName}</h3>
      <p>계약 ID: {contract.contractId}</p>
      <p>총 비용: {contract.totalCost.toLocaleString()}원</p>
      <p>상태: {CONTRACT_STATUS_LABELS[contract.status]}</p>
    </div>
  );
};
```

