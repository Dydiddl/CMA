#### PySide6 성능 최적화 규칙
```python
class PySide6PerformanceOptimizer:
    """PySide6 성능 최적화"""
    
    @staticmethod
    def optimize_table_performance(table: QTableWidget):
        """테이블 성능 최적화"""
        # 가상화 설정
        table.setVerticalScrollMode(QAbstractItemView.ScrollPerPixel)
        table.setHorizontalScrollMode(QAbstractItemView.ScrollPerPixel)
        
        # 선택 모드 설정
        table.setSelectionBehavior(QAbstractItemView.SelectRows)
        table.setSelectionMode(QAbstractItemView.SingleSelection)
        
        # 정렬 최적화
        table.setSortingEnabled(True)
    
    @staticmethod
    def batch_update_table(table: QTableWidget, data: List[Dict]):
        """테이블 배치 업데이트"""
        table.setRowCount(len(data))
        
        for row, item_data in enumerate(data):
            for col, value in enumerate(item_data.values()):
                table_item = QTableWidgetItem(str(value))
                table.setItem(row, col, table_item)
```

