#### PySide6 비동기 처리 규칙
```python
class AsyncWorker(QThread):
    """비동기 작업 처리 클래스 - 반드시 사용"""
    
    # 시그널 정의
    progress_updated = pyqtSignal(int)
    work_finished = pyqtSignal(object)
    error_occurred = pyqtSignal(str)
    
    def __init__(self, work_function, *args, **kwargs):
        super().__init__()
        self.work_function = work_function
        self.args = args
        self.kwargs = kwargs
    
    def run(self):
        """작업 실행"""
        try:
            result = self.work_function(*self.args, **self.kwargs)
            self.work_finished.emit(result)
        except Exception as e:
            self.error_occurred.emit(str(e))

class PySide6AsyncHandler:
    """PySide6 비동기 처리 핸들러"""
    
    def __init__(self, main_window):
        self.main_window = main_window
        self.workers = []
    
    def execute_async_task(self, task_func, *args, **kwargs):
        """비동기 작업 실행"""
        worker = AsyncWorker(task_func, *args, **kwargs)
        worker.work_finished.connect(self.on_task_completed)
        worker.error_occurred.connect(self.on_task_error)
        worker.start()
        
        self.workers.append(worker)
        return worker
    
    def on_task_completed(self, result):
        """작업 완료 처리"""
        self.main_window.statusBar().showMessage("작업 완료")
        # 결과 처리 로직
    
    def on_task_error(self, error_message):
        """작업 오류 처리"""
        self.main_window.statusBar().showMessage(f"오류: {error_message}")
        # 오류 처리 로직
```

#### PySide6 데이터베이스 연동 규칙
```python
class PySide6DatabaseManager:
    """PySide6 데이터베이스 관리자"""
    
    def __init__(self):
        self.engine = None
        self.session = None
    
    def initialize_database(self, database_url: str):
        """데이터베이스 초기화"""
        try:
            from sqlalchemy import create_engine
            from sqlalchemy.orm import sessionmaker
            
            self.engine = create_engine(database_url)
            Session = sessionmaker(bind=self.engine)
            self.session = Session()
            
            return True
        except Exception as e:
            print(f"데이터베이스 초기화 실패: {e}")
            return False
    
    def execute_query(self, query_func):
        """쿼리 실행"""
        try:
            result = query_func(self.session)
            return result
        except Exception as e:
            print(f"쿼리 실행 실패: {e}")
            return None
        finally:
            self.session.close()
```

