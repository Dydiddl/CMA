---
# CMA (Construction Management System) Project Rules

## 🎯 Project Overview
CMA는 건설 공사 내역서 자동화 시스템으로, 계약 관리, 재무 관리, 노무 관리, 문서 처리 등을 통합적으로 제공하는 Python + React + Tauri 기반의 데스크톱 애플리케이션입니다.

## 📁 Project Structure
```
CMA/
├── backend/                 # Python FastAPI 백엔드
│   ├── app/
│   │   ├── api/            # API 엔드포인트
│   │   ├── models/         # 데이터베이스 모델
│   │   ├── schemas/        # Pydantic 스키마
│   │   ├── services/       # 비즈니스 로직
│   │   └── core/           # 설정 및 보안
├── frontend/               # React + TypeScript 프론트엔드
│   ├── src/
│   │   ├── components/     # React 컴포넌트
│   │   ├── pages/          # 페이지 컴포넌트
│   │   └── services/       # API 서비스
└── src-tauri/             # Tauri 데스크톱 앱 설정
```

## 🚨 CRITICAL RULES - MUST FOLLOW

### 1. 코드 스타일 (PEP8 준수, snake_case 변수명)

#### Python 백엔드
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
건설 관리 시스템 - [모듈명]
[모듈 설명]
"""

from typing import List, Dict, Optional, Union
from datetime import datetime
from pathlib import Path
import logging

logger = logging.getLogger(__name__)

class ConstructionContract:
    """건설 계약 관리 클래스"""
    
    def __init__(self, contract_id: str, project_name: str):
        self.contract_id = contract_id
        self.project_name = project_name
        self.created_at = datetime.now()
        self.status = "draft"
    
    def calculate_total_cost(self, labor_cost: float, material_cost: float) -> float:
        """총 비용 계산"""
        return labor_cost + material_cost
    
    def update_contract_status(self, new_status: str) -> bool:
        """계약 상태 업데이트"""
        try:
            self.status = new_status
            logger.info(f"계약 상태 업데이트: {self.contract_id} -> {new_status}")
            return True
        except Exception as e:
            logger.error(f"계약 상태 업데이트 실패: {e}")
            return False
```

#### TypeScript 프론트엔드
```typescript
// 파일명: construction-contract.ts
// 컴포넌트명: ConstructionContract
// 변수명: camelCase
// 상수명: UPPER_SNAKE_CASE

interface ConstructionContract {
  contractId: string;
  projectName: string;
  totalCost: number;
  status: ContractStatus;
  createdAt: Date;
}

enum ContractStatus {
  DRAFT = 'draft',
  ACTIVE = 'active',
  COMPLETED = 'completed',
  CANCELLED = 'cancelled'
}

const CONTRACT_STATUS_LABELS: Record<ContractStatus, string> = {
  [ContractStatus.DRAFT]: '초안',
  [ContractStatus.ACTIVE]: '진행중',
  [ContractStatus.COMPLETED]: '완료',
  [ContractStatus.CANCELLED]: '취소'
};

export const ConstructionContractComponent: React.FC<{
  contract: ConstructionContract;
  onStatusChange: (status: ContractStatus) => void;
}> = ({ contract, onStatusChange }) => {
  const handleStatusUpdate = (newStatus: ContractStatus) => {
    try {
      onStatusChange(newStatus);
    } catch (error) {
      console.error('계약 상태 업데이트 실패:', error);
    }
  };

  return (
    <div className="construction-contract">
      <h3>{contract.projectName}</h3>
      <p>계약 ID: {contract.contractId}</p>
      <p>총 비용: {contract.totalCost.toLocaleString()}원</p>
      <p>상태: {CONTRACT_STATUS_LABELS[contract.status]}</p>
    </div>
  );
};
```

### 2. 파일 분리 기준

#### 백엔드 구조
```python
# models/contract.py - 데이터베이스 모델
from sqlalchemy import Column, String, DateTime, Float, Enum
from sqlalchemy.sql import func
from ..db.base import Base

class Contract(Base):
    __tablename__ = "contracts"
    
    id = Column(String, primary_key=True, index=True)
    project_name = Column(String, nullable=False)
    contract_amount = Column(Float, nullable=False)
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    status = Column(Enum("draft", "active", "completed", "cancelled"), default="draft")

# schemas/contract.py - Pydantic 스키마
from pydantic import BaseModel, Field
from datetime import datetime
from typing import Optional

class ContractBase(BaseModel):
    project_name: str = Field(..., description="프로젝트명")
    contract_amount: float = Field(..., description="계약금액")

class ContractCreate(ContractBase):
    pass

class ContractUpdate(BaseModel):
    project_name: Optional[str] = None
    contract_amount: Optional[float] = None
    status: Optional[str] = None

class ContractResponse(ContractBase):
    id: str
    created_at: datetime
    status: str
    
    class Config:
        from_attributes = True

# services/contract.py - 비즈니스 로직
from ..models.contract import Contract
from ..schemas.contract import ContractCreate, ContractUpdate
from sqlalchemy.orm import Session

class ContractService:
    def __init__(self, db: Session):
        self.db = db
    
    def create_contract(self, contract_data: ContractCreate) -> Contract:
        """계약 생성"""
        db_contract = Contract(**contract_data.dict())
        self.db.add(db_contract)
        self.db.commit()
        self.db.refresh(db_contract)
        return db_contract

# api/v1/endpoints/contracts.py - API 엔드포인트
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from ....db.database import get_db
from ....services.contract import ContractService
from ....schemas.contract import ContractCreate, ContractResponse

router = APIRouter()

@router.post("/", response_model=ContractResponse)
def create_contract(
    contract: ContractCreate,
    db: Session = Depends(get_db)
):
    """계약 생성 API"""
    contract_service = ContractService(db)
    return contract_service.create_contract(contract)
```

#### 프론트엔드 구조
```typescript
// types/contract.ts - 타입 정의
export interface Contract {
  id: string;
  projectName: string;
  contractAmount: number;
  status: ContractStatus;
  createdAt: Date;
}

// services/contractService.ts - API 서비스
import { Contract } from '../types/contract';

export class ContractService {
  private static readonly API_BASE_URL = '/api/v1/contracts';

  static async createContract(contractData: Omit<Contract, 'id' | 'createdAt'>): Promise<Contract> {
    const response = await fetch(this.API_BASE_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(contractData),
    });

    if (!response.ok) {
      throw new Error('계약 생성 실패');
    }

    return response.json();
  }
}

// components/contract/ContractForm.tsx - 컴포넌트
import React, { useState } from 'react';
import { ContractService } from '../../services/contractService';

export const ContractForm: React.FC = () => {
  const [formData, setFormData] = useState({
    projectName: '',
    contractAmount: 0,
  });

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      await ContractService.createContract(formData);
      // 성공 처리
    } catch (error) {
      console.error('계약 생성 실패:', error);
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      {/* 폼 내용 */}
    </form>
  );
};
```

### 3. 문서화 원칙

#### 모든 함수에 docstring 작성
```python
def calculate_construction_cost(
    labor_hours: float,
    labor_rate: float,
    material_cost: float,
    overhead_rate: float = 0.15
) -> Dict[str, float]:
    """
    건설 비용을 계산합니다.
    
    Args:
        labor_hours (float): 노동 시간
        labor_rate (float): 시간당 노동 비용
        material_cost (float): 재료 비용
        overhead_rate (float, optional): 간접비율. 기본값 0.15 (15%)
    
    Returns:
        Dict[str, float]: 계산된 비용 정보
            - labor_cost: 노동 비용
            - material_cost: 재료 비용
            - overhead_cost: 간접비
            - total_cost: 총 비용
    
    Raises:
        ValueError: 음수 값이 입력된 경우
        TypeError: 잘못된 타입이 입력된 경우
    
    Example:
        >>> cost_info = calculate_construction_cost(100, 50000, 1000000)
        >>> print(cost_info['total_cost'])
        6750000.0
    """
    if labor_hours < 0 or labor_rate < 0 or material_cost < 0:
        raise ValueError("비용은 음수일 수 없습니다.")
    
    labor_cost = labor_hours * labor_rate
    overhead_cost = (labor_cost + material_cost) * overhead_rate
    total_cost = labor_cost + material_cost + overhead_cost
    
    return {
        "labor_cost": labor_cost,
        "material_cost": material_cost,
        "overhead_cost": overhead_cost,
        "total_cost": total_cost
    }
```

