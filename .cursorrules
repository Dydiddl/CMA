```python
# tests/test_contract_service.py
import pytest
from unittest.mock import Mock, patch
from app.services.contract import ContractService
from app.schemas.contract import ContractCreate
from app.utils.exceptions import ContractNotFoundException

class TestContractService:
    @pytest.fixture
    def mock_db(self):
        return Mock()
    
    @pytest.fixture
    def mock_cache(self):
        return Mock()
    
    @pytest.fixture
    def contract_service(self, mock_db, mock_cache):
        return ContractService(mock_db, mock_cache)
    
    @pytest.mark.asyncio
    async def test_create_contract_success(self, contract_service, mock_db, mock_cache):
        """계약 생성 성공 테스트"""
        # Given
        contract_data = ContractCreate(
            project_name="테스트 프로젝트",
            contract_amount=1000000
        )
        mock_contract = Mock()
        mock_contract.id = "test-id"
        mock_db.add.return_value = None
        mock_db.commit.return_value = None
        mock_cache.setex.return_value = None
        
        # When
        result = await contract_service.create_contract(contract_data)
        
        # Then
        assert result.id == "test-id"
        mock_db.add.assert_called_once()
        mock_db.commit.assert_called_once()
        mock_cache.setex.assert_called_once()
    
    @pytest.mark.asyncio
    async def test_get_contract_not_found(self, contract_service, mock_db):
        """계약 조회 실패 테스트"""
        # Given
        contract_id = "non-existent-id"
        mock_db.query.return_value.filter.return_value.first.return_value = None
        
        # When & Then
        with pytest.raises(ContractNotFoundException):
            await contract_service.get_contract(contract_id)
