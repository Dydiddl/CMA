### 🆕 5. 하이브리드 아키텍처 개발 규칙

#### 성능 최적화 우선순위
```python
# 성능 최적화 우선순위 정의
PERFORMANCE_PRIORITY = {
    "HIGH": [
        "PDF 처리 (ASCR 모듈)",
        "대용량 Excel 처리",
        "복잡한 수식 계산",
        "데이터베이스 쿼리"
    ],
    "MEDIUM": [
        "API 응답 시간",
        "파일 업로드/다운로드",
        "캐싱 전략"
    ],
    "LOW": [
        "UI 렌더링",
        "로그 처리",
        "설정 관리"
    ]
}

class PerformanceOptimizer:
    """성능 최적화 관리자"""
    
    def __init__(self):
        self.optimization_history = []
    
    async def optimize_module(self, module_name: str, priority: str):
        """모듈별 성능 최적화"""
        if priority == "HIGH":
            # 네이티브 전환 고려
            await self._consider_native_optimization(module_name)
        elif priority == "MEDIUM":
            # 비동기/멀티프로세싱 최적화
            await self._apply_async_optimization(module_name)
        else:
            # 기본 최적화
            await self._apply_basic_optimization(module_name)
    
    async def _consider_native_optimization(self, module_name: str):
        """네이티브 최적화 고려"""
        # 성능 측정
        current_performance = await self._measure_performance(module_name)
        
        if current_performance < PERFORMANCE_TARGETS.get(module_name, 1000):
            logger.info(f"{module_name}: 네이티브 최적화 필요")
            # 네이티브 전환 계획 수립
```

