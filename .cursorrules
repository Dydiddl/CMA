#### PDF 라이브러리 사용 규칙
```python
# ✅ 권장: pypdf 사용
from pypdf import PdfReader, PdfWriter

def extract_pdf_text(pdf_path: str) -> str:
    """PDF 텍스트 추출 - pypdf 사용"""
    reader = PdfReader(pdf_path)
    text = ""
    for page in reader.pages:
        text += page.extract_text() + "\n"
    return text

# ✅ 권장: tabula-py 사용 (테이블 추출)
import tabula

def extract_pdf_tables(pdf_path: str) -> List[pd.DataFrame]:
    """PDF 테이블 추출 - tabula-py 사용"""
    tables = tabula.read_pdf(pdf_path, pages='all')
    return tables

# ✅ 권장: PyMuPDF 사용 (고성능 처리)
import fitz

def process_pdf_high_performance(pdf_path: str) -> Dict[str, Any]:
    """고성능 PDF 처리 - PyMuPDF 사용"""
    doc = fitz.open(pdf_path)
    # 고성능 처리 로직
    return {"pages": len(doc), "text": doc.get_text()}

# ❌ 금지: PyPDF2 사용
# from PyPDF2 import PdfReader, PdfWriter  # 더 이상 지원되지 않음
```

#### PDF 라이브러리 선택 가이드
```python
# PDF 처리 목적별 라이브러리 선택
PDF_LIBRARY_SELECTION = {
    "텍스트 추출": "pypdf",  # 기본 텍스트 추출
    "테이블 추출": "tabula-py",  # 복잡한 테이블 구조
    "고성능 처리": "PyMuPDF",  # 대용량 파일, 이미지 추출
    "정밀한 텍스트": "pdfplumber",  # 레이아웃 보존
    "이미지 변환": "pdf2image",  # PDF를 이미지로
    "문서 변환": "pdf2docx"  # PDF를 Word로
}

def select_pdf_library(purpose: str) -> str:
    """목적에 따른 PDF 라이브러리 선택"""
    return PDF_LIBRARY_SELECTION.get(purpose, "pypdf")
```

### 🆕 5. 이모지 사용 최소화 규칙 (MANDATORY)

#### 이모지 사용 제한 사유
- **크로스 플랫폼 호환성**: macOS, Windows, Linux 간 이모지 렌더링 차이
- **폰트 지원 문제**: 시스템 폰트에서 지원하지 않는 이모지로 인한 깨짐 현상
- **가독성 향상**: 텍스트 기반 표현이 더 명확하고 일관성 있음
- **접근성**: 스크린 리더 및 보조 기술과의 호환성

#### 이모지 사용 금지 영역
```python
# 금지: 이모지 사용
logger.info("✅ 성공적으로 처리되었습니다")
print("❌ 오류가 발생했습니다")
return {"status": "⚠️ 경고", "message": "데이터가 누락되었습니다"}

# 권장: 텍스트 기반 표현
logger.info("[SUCCESS] 성공적으로 처리되었습니다")
print("[ERROR] 오류가 발생했습니다")
return {"status": "WARNING", "message": "데이터가 누락되었습니다"}
```

#### 허용되는 이모지 (최소한으로)
```python
# 허용: 기본적인 상태 표시 (안정적인 이모지만)
# ✅ 성공 (대신) [SUCCESS] 또는 [OK]
# ❌ 실패 (대신) [ERROR] 또는 [FAIL]
# ⚠️ 경고 (대신) [WARNING] 또는 [CAUTION]
# ℹ️ 정보 (대신) [INFO] 또는 [NOTE]

# 권장: 텍스트 기반 상태 표시
STATUS_SUCCESS = "[SUCCESS]"
STATUS_ERROR = "[ERROR]"
STATUS_WARNING = "[WARNING]"
STATUS_INFO = "[INFO]"
```

#### 코드에서 이모지 대체 규칙
```python
# Python 코드 예시
class ContractService:
    def create_contract(self, contract_data: ContractCreate) -> Contract:
        """계약 생성"""
        try:
            # 계약 생성 로직
            contract = Contract(**contract_data.dict())
            self.db.add(contract)
            self.db.commit()
            
            # 로그 메시지 (이모지 대신 텍스트 사용)
            logger.info("[SUCCESS] 계약이 성공적으로 생성되었습니다")
            return contract
            
        except Exception as e:
            # 오류 메시지 (이모지 대신 텍스트 사용)
            logger.error(f"[ERROR] 계약 생성 실패: {e}")
            raise ContractCreationError(f"계약 생성 중 오류 발생: {e}")

# TypeScript 코드 예시
const CONTRACT_STATUS = {
  SUCCESS: '[SUCCESS]',
  ERROR: '[ERROR]',
  WARNING: '[WARNING]',
  INFO: '[INFO]'
} as const;

const handleContractCreation = async (data: ContractData) => {
  try {
    const result = await contractService.create(data);
    console.log(`${CONTRACT_STATUS.SUCCESS} 계약이 성공적으로 생성되었습니다`);
    return result;
  } catch (error) {
    console.error(`${CONTRACT_STATUS.ERROR} 계약 생성 실패:`, error);
    throw error;
  }
};
```

