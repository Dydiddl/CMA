#### API 응답 형식 표준화
```python
# schemas/common.py
from pydantic import BaseModel
from typing import Generic, TypeVar, Optional, Any
from datetime import datetime

T = TypeVar('T')

class APIResponse(BaseModel, Generic[T]):
    """표준 API 응답 형식"""
    success: bool
    message: str
    data: Optional[T] = None
    timestamp: datetime = datetime.now()
    error_code: Optional[str] = None

class PaginatedResponse(BaseModel, Generic[T]):
    """페이지네이션 응답 형식"""
    items: List[T]
    total: int
    page: int
    size: int
    pages: int

# 사용 예시
@router.get("/", response_model=PaginatedResponse[ContractResponse])
async def get_contracts(
    page: int = 1,
    size: int = 20,
    db: Session = Depends(get_db)
):
    """계약 목록 조회 (페이지네이션)"""
    contracts = contract_service.get_contracts(db, skip=(page-1)*size, limit=size)
    total = contract_service.count_contracts(db)
    
    return PaginatedResponse(
        items=contracts,
        total=total,
        page=page,
        size=size,
        pages=(total + size - 1) // size
    )
```

### 5. 예외처리 방식

#### 백엔드 예외처리
```python
# utils/exceptions.py
from fastapi import HTTPException, status
from typing import Any, Dict, Optional

class CMAException(Exception):
    """CMA 프로젝트 기본 예외 클래스"""
    
    def __init__(
        self,
        message: str,
        error_code: str,
        status_code: int = status.HTTP_500_INTERNAL_SERVER_ERROR,
        details: Optional[Dict[str, Any]] = None
    ):
        self.message = message
        self.error_code = error_code
        self.status_code = status_code
        self.details = details or {}
        super().__init__(self.message)

class ContractNotFoundException(CMAException):
    """계약을 찾을 수 없을 때 발생하는 예외"""
    
    def __init__(self, contract_id: str):
        super().__init__(
            message=f"계약을 찾을 수 없습니다: {contract_id}",
            error_code="CONTRACT_NOT_FOUND",
            status_code=status.HTTP_404_NOT_FOUND,
            details={"contract_id": contract_id}
        )

class InvalidContractDataException(CMAException):
    """잘못된 계약 데이터일 때 발생하는 예외"""
    
    def __init__(self, field: str, value: Any):
        super().__init__(
            message=f"잘못된 계약 데이터: {field} = {value}",
            error_code="INVALID_CONTRACT_DATA",
            status_code=status.HTTP_400_BAD_REQUEST,
            details={"field": field, "value": str(value)}
        )

# services/contract.py
import logging
from ..utils.exceptions import ContractNotFoundException, InvalidContractDataException

logger = logging.getLogger(__name__)

class ContractService:
    def get_contract(self, contract_id: str) -> Contract:
        """계약 조회"""
        try:
            contract = self.db.query(Contract).filter(Contract.id == contract_id).first()
            if not contract:
                logger.warning(f"계약을 찾을 수 없음: {contract_id}")
                raise ContractNotFoundException(contract_id)
            
            logger.info(f"계약 조회 성공: {contract_id}")
            return contract
            
        except ContractNotFoundException:
            raise
        except Exception as e:
            logger.error(f"계약 조회 중 오류 발생: {contract_id}, 오류: {str(e)}")
            raise CMAException(
                message="계약 조회 중 오류가 발생했습니다.",
                error_code="CONTRACT_QUERY_ERROR",
                details={"contract_id": contract_id}
            )
    
    def create_contract(self, contract_data: ContractCreate) -> Contract:
        """계약 생성"""
        try:
            # 데이터 검증
            if contract_data.contract_amount <= 0:
                raise InvalidContractDataException("contract_amount", contract_data.contract_amount)
            
            # 계약 생성
            db_contract = Contract(**contract_data.dict())
            self.db.add(db_contract)
            self.db.commit()
            self.db.refresh(db_contract)
            
            logger.info(f"계약 생성 성공: {db_contract.id}")
            return db_contract
            
        except InvalidContractDataException:
            raise
        except Exception as e:
            self.db.rollback()
            logger.error(f"계약 생성 중 오류 발생: {str(e)}")
            raise CMAException(
                message="계약 생성 중 오류가 발생했습니다.",
                error_code="CONTRACT_CREATION_ERROR"
            )

# middleware/error_handler.py
from fastapi import Request, status
from fastapi.responses import JSONResponse
from ..utils.exceptions import CMAException

async def cma_exception_handler(request: Request, exc: CMAException):
    """CMA 예외 처리 미들웨어"""
    return JSONResponse(
        status_code=exc.status_code,
        content={
            "success": False,
            "message": exc.message,
            "error_code": exc.error_code,
            "details": exc.details,
            "timestamp": datetime.now().isoformat()
        }
    )
```

#### 프론트엔드 예외처리
```typescript
// utils/errorHandler.ts
export class CMAError extends Error {
  constructor(
    message: string,
    public errorCode: string,
    public statusCode: number = 500,
    public details?: Record<string, any>
  ) {
    super(message);
    this.name = 'CMAError';
  }
}

export class ContractNotFoundError extends CMAError {
  constructor(contractId: string) {
    super(
      `계약을 찾을 수 없습니다: ${contractId}`,
      'CONTRACT_NOT_FOUND',
      404,
      { contractId }
    );
  }
}

// services/apiClient.ts
export class ApiClient {
  private static async handleResponse<T>(response: Response): Promise<T> {
    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}));
      
      switch (response.status) {
        case 404:
          throw new ContractNotFoundError(errorData.details?.contract_id || 'unknown');
        case 400:
          throw new CMAError(
            errorData.message || '잘못된 요청입니다.',
            errorData.error_code || 'BAD_REQUEST',
            400,
            errorData.details
          );
        case 500:
          throw new CMAError(
            errorData.message || '서버 오류가 발생했습니다.',
            errorData.error_code || 'INTERNAL_SERVER_ERROR',
            500,
            errorData.details
          );
        default:
          throw new CMAError(
            errorData.message || '알 수 없는 오류가 발생했습니다.',
            errorData.error_code || 'UNKNOWN_ERROR',
            response.status,
            errorData.details
          );
      }
    }
    
    return response.json();
  }

  static async get<T>(url: string): Promise<T> {
    try {
      const response = await fetch(url);
      return this.handleResponse<T>(response);
    } catch (error) {
      console.error('API 요청 실패:', error);
      throw error;
    }
  }

  static async post<T>(url: string, data: any): Promise<T> {
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });
      return this.handleResponse<T>(response);
    } catch (error) {
      console.error('API 요청 실패:', error);
      throw error;
    }
  }
}

// components/ErrorBoundary.tsx
import React, { Component, ErrorInfo, ReactNode } from 'react';
import { CMAError } from '../utils/errorHandler';

interface Props {
  children: ReactNode;
  fallback?: ReactNode;
}

interface State {
  hasError: boolean;
  error?: Error;
}

export class ErrorBoundary extends Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error): State {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    console.error('ErrorBoundary에서 오류 발생:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      if (this.props.fallback) {
        return this.props.fallback;
      }

      return (
        <div className="error-boundary">
          <h2>오류가 발생했습니다</h2>
          <p>{this.state.error?.message}</p>
          <button onClick={() => this.setState({ hasError: false })}>
            다시 시도
          </button>
        </div>
      );
    }

    return this.props.children;
  }
}
```

## 📋 추가 규칙

### 6. 데이터베이스 모델 설계
```python
# models/base.py
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy import Column, DateTime, String
from sqlalchemy.sql import func

Base = declarative_base()

class TimestampMixin:
    """타임스탬프 믹스인"""
    created_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
    updated_at = Column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False)

class SoftDeleteMixin:
    """소프트 삭제 믹스인"""
    deleted_at = Column(DateTime(timezone=True), nullable=True)
    is_deleted = Column(Boolean, default=False, nullable=False)
```

### 7. 환경 설정 관리
```python
# core/config.py
from pydantic_settings import BaseSettings
from typing import Optional

class Settings(BaseSettings):
    """애플리케이션 설정"""
    
    # 데이터베이스 설정
    database_url: str = "postgresql://user:password@localhost/cma_db"
    
    # 보안 설정
    secret_key: str = "your-secret-key"
    access_token_expire_minutes: int = 30
    
    # 파일 업로드 설정
    upload_dir: str = "./uploads"
    max_file_size: int = 10 * 1024 * 1024  # 10MB
    
    # 로깅 설정
    log_level: str = "INFO"
    log_file: str = "./logs/cma.log"
    
    class Config:
        env_file = ".env"
        case_sensitive = False

settings = Settings()
```

### 8. 테스트 코드 작성
```python
# tests/test_contract_service.py
import pytest
from unittest.mock import Mock, patch
from app.services.contract import ContractService
from app.schemas.contract import ContractCreate
from app.utils.exceptions import ContractNotFoundException

class TestContractService:
    @pytest.fixture
    def mock_db(self):
        return Mock()
    
    @pytest.fixture
    def contract_service(self, mock_db):
        return ContractService(mock_db)
    
    def test_create_contract_success(self, contract_service, mock_db):
        """계약 생성 성공 테스트"""
        # Given
        contract_data = ContractCreate(
            project_name="테스트 프로젝트",
            contract_amount=1000000
        )
        mock_contract = Mock()
        mock_contract.id = "test-id"
        mock_db.add.return_value = None
        mock_db.commit.return_value = None
        mock_db.refresh.return_value = None
        
        # When
        result = contract_service.create_contract(contract_data)
        
        # Then
        assert result.id == "test-id"
        mock_db.add.assert_called_once()
        mock_db.commit.assert_called_once()
    
    def test_get_contract_not_found(self, contract_service, mock_db):
        """계약 조회 실패 테스트"""
        # Given
        contract_id = "non-existent-id"
        mock_db.query.return_value.filter.return_value.first.return_value = None
        
        # When & Then
        with pytest.raises(ContractNotFoundException):
            contract_service.get_contract(contract_id)
```

