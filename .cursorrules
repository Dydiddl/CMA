### 🆕 6. 성능 모니터링 및 알림 시스템

#### 실시간 성능 모니터링
```python
# 실시간 성능 모니터링
class PerformanceMonitor:
    """실시간 성능 모니터링"""
    
    def __init__(self):
        self.metrics = {}
        self.alerts = []
    
    async def monitor_system_performance(self):
        """시스템 성능 모니터링"""
        while True:
            # CPU 사용률
            cpu_usage = psutil.cpu_percent()
            
            # 메모리 사용률
            memory_usage = psutil.virtual_memory().percent
            
            # 디스크 사용률
            disk_usage = psutil.disk_usage('/').percent
            
            # 성능 지표 저장
            self.metrics = {
                'cpu_usage': cpu_usage,
                'memory_usage': memory_usage,
                'disk_usage': disk_usage,
                'timestamp': datetime.now()
            }
            
            # 임계값 체크
            await self._check_thresholds()
            
            # 30초 대기
            await asyncio.sleep(30)
    
    async def _check_thresholds(self):
        """임계값 체크 및 알림"""
        if self.metrics['cpu_usage'] > 80:
            await self._send_alert("CPU 사용률 높음", self.metrics['cpu_usage'])
        
        if self.metrics['memory_usage'] > 85:
            await self._send_alert("메모리 사용률 높음", self.metrics['memory_usage'])
    
    async def _send_alert(self, message: str, value: float):
        """알림 전송"""
        alert = {
            'message': message,
            'value': value,
            'timestamp': datetime.now()
        }
        self.alerts.append(alert)
        logger.warning(f"성능 알림: {message} - {value}%")
```

