# CMA Backend Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME=CMA Construction Management System
APP_VERSION=3.1.0
DEBUG=false
ENVIRONMENT=production

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/cma_db
# Alternative: SQLite for development
# DATABASE_URL=sqlite:///./construction_management.db

# PostgreSQL Settings (if using PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=cma_db

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS Settings
ALLOWED_HOSTS=["http://localhost:3000", "http://localhost:5173", "tauri://localhost"]

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=[".pdf", ".xlsx", ".xls", ".doc", ".docx"]

# ASCR Module Settings
ASCR_UPLOAD_DIR=./uploads/ascr
ASCR_TEMP_DIR=./temp

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=./logs/cma.log

# Performance Settings
MAX_WORKERS=4
CACHE_TTL=3600

# Redis Settings (if using Redis for caching)
REDIS_URL=redis://localhost:6379/0

# Email Settings (if using email notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# External Services
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key 